{% extends 'base.html.twig' %}

{% block title %}{{ 'title.events_list'|trans }}{% endblock %}

{% block body %}

    <h1>{{ 'title.events_list'|trans }}</h1>
    {% if app.user %}

        <div class="d-flex flex-direction-row align-items-center gap-3">
            <div class="mb-2" style="max-width: 200px;">
                <label for="categoryFilter" class="form-label">{{ 'label.filter_by_category'|trans }}</label>
                <select
                    id="categoryFilter"
                    class="form-select"
                    onchange="location = this.value"
                >
                    <option value="{{ path('app_event_index', {
                        tagId: currentTag,
                        title: title
                    }) }}"
                            {% if currentCategory is null %}selected{% endif %}>
                        {{ 'option.all'|trans }}
                    </option>

                    {% for category in categories %}
                        <option value="{{ path('app_event_index', {
                            categoryId: category.id,
                            tagId: currentTag,
                            title: title
                        }) }}"
                                {% if currentCategory == category.id %}selected{% endif %}>
                            {{ category.title }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-2" style="max-width: 200px;">
                <label for="tagFilter" class="form-label">{{ 'label.filter_by_tag'|trans }}</label>
                <select
                    id="tagFilter"
                    class="form-select"
                    onchange="location = this.value"
                >
                    <option value="{{ path('app_event_index', {
                        categoryId: currentCategory,
                        title: title
                    }) }}"
                            {% if currentTag is null %}selected{% endif %}>
                        {{ 'option.all'|trans }}
                    </option>

                    {% for tag in tags %}
                        <option value="{{ path('app_event_index', {
                            categoryId: currentCategory,
                            tagId: tag.id,
                            title: title
                        }) }}"
                                {% if currentTag == tag.id %}selected{% endif %}>
                            #{{ tag.title }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-2">
                <label class="form-label">{{ 'label.search_events'|trans }}</label>
                <form method="get" class="d-flex gap-2">
                    <input type="text"
                           name="title"
                           value="{{ app.request.get('title') }}"
                           class="form-control"
                           placeholder="{{ 'placeholder.search_by_title'|trans }}">

                    <button class="btn btn-primary">{{ 'button.search'|trans }}</button>

                    <a href="{{ path('app_event_index') }}" class="btn btn-secondary">
                        {{ 'button.reset'|trans }}
                    </a>
                </form>
            </div>
        </div>

        <table class="table">
            <colgroup>
                {# Title #}
                <col style="width: 10%;">
                {# Description #}
                <col style="width: 15%;">
                {# Start Date #}
                <col style="width: 15%;">
                {# End Date #}
                <col style="width: 10%;">
                {# Location #}
                <col style="width: 10%;">
                {# Status #}
                <col style="width: 10%;">
                {# Category #}
                <col style="width: 10%;">
                {# Tag #}
                <col style="width: 10%;">
                {# Actions #}
                <col style="width: 10%;">
            </colgroup>
            <thead>
            <tr>
                <th>{{ 'th.title'|trans }}</th>
                <th>{{ 'th.description'|trans }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'th.start_date'|trans, 'event.startDate') }}</th>
                <th>{{ 'th.end_date'|trans }}</th>
                <th>{{ 'th.location'|trans }}</th>
                <th>{{ 'th.status'|trans }}</th>
                <th>{{ 'th.category'|trans }}</th>
                <th>{{ 'option.tags'|trans }}</th>
                <th>{{ 'th.actions'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for event in pagination.items %}
                <tr>
                    <td>{{ event.title }}</td>
                    <td>{{ event.description }}</td>
                    <td>{{ event.startDate ? event.startDate|format_date('medium') : '' }}</td>
                    <td>{{ event.endDate ? event.endDate|format_date('medium') : '-' }}</td>
                    <td>{{ event.location }}</td>
                    <td>{{ event.status }}</td>
                    <td>{{ event.category }}</td>
                    <td>
                        {% for tag in event.tags %}
                            <span class="badge bg-secondary">
                            #{{ tag.title }}
                        </span>
                        {% else %}
                            -
                        {% endfor %}
                    </td>

                    {% if app.user %}
                        <td>
                            <a class="btn btn-primary btn-sm edit-event-btn" href="{{ path('app_event_edit', {'id': event.id}) }}">{{ 'button.edit'|trans }}</a>
                            <a class="btn btn-danger btn-sm" href="{{ path('app_event_delete', {'id': event.id}) }}">{{ 'button.delete'|trans }}</a>
                        </td>
                    {% else %}
                        <td>-</td>
                    {% endif %}
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">{{ 'tr.no_records'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="d-flex justify-content-center navigation mt-1">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <div class="d-flex justify-content-center gap-2 mt-2 mb-2">
            <h3>{{ 'header.not_logged_info'|trans }}</h3>
        </div>
    {% endif %}

    <div class="d-flex justify-content-center gap-2 mt-2 mb-2">
        <a class="btn btn-success" href="{{ path('app_event_new') }}">{{ 'button.create_new'|trans }}</a>
        {% if app.user %}
            <a href="{{ path('app_event_export') }}" class="btn btn-primary">
                {{ 'button.export'|trans }}
            </a>
        {% endif %}
    </div>
{% endblock %}
