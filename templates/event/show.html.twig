{% extends 'base.html.twig' %}

{% block title %}{{ 'title.event'|trans }}{% endblock %}

{% block body %}
<div class="container d-flex justify-content-center align-items-center mt-3">
    <div class="auth-card d-flex flex-column gap-1" style="max-width: 850px;">
        <div class="h3 mb-2 font-weight-normal">{{ 'title.event'|trans }}</div>
        <table class="table">
            <tbody>
                <tr>
                    <th>{{ 'th.id'|trans }}</th>
                    <td>{{ event.id }}</td>
                </tr>
                <tr>
                    <th>{{ 'th.title'|trans }}</th>
                    <td>{{ event.title }}</td>
                </tr>
                <tr>
                    <th>{{ 'th.description'|trans }}</th>
                    <td>{{ event.description }}</td>
                </tr>
                <tr>
                    <th>{{ 'th.start_date'|trans }}</th>
                    <td>{{ event.startDate ? event.startDate|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th>{{ 'th.end_date'|trans }}</th>
                    <td>{{ event.endDate ? event.endDate|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th>{{ 'th.location'|trans }}</th>
                    <td>{{ event.location }}</td>
                </tr>
                <tr>
                    <th>{{ 'th.status'|trans }}</th>
                    <td>{{ event.status }}</td>
                </tr>
                <tr>
                    <th>{{ 'th.category'|trans }}</th>
                    <td>{{ event.category }}</td>
                </tr>
            </tbody>
        </table>
        <div class="d-flex flex-row justify-content-center align-items-center gap-2">
            <a href="{{ path('app_event_index') }}" class="btn btn-primary"><< {{ 'button.back'|trans }}</a>
            <a href="{{ path('app_event_edit', {'id': event.id})}}" class="btn btn-warning">{{ 'button.edit'|trans }}</a>
        </div>
    </div>
{#    {{ include('event/_delete_form.html.twig') }}#}
</div>

{% endblock %}
