{% extends 'base.html.twig' %}

{% block title %}{{ 'title.new_event'|trans }}{% endblock %}
{% block body %}
<div class="container d-flex justify-content-center align-items-center mt-2" style="max-width: 500px;">
    <div class="auth-card p-3">
        <h1 class="h3 mb-1 font-weight-normal">{{ 'title.create_new_event'|trans }}</h1>
        {{ include('event/_form.html.twig', { form: form }) }}

        <div class="d-flex flex-row justify-content-center align-items-center gap-2">
            <a href="{{ path('app_event_index') }}" class="btn btn-primary"> << {{ 'button.back'|trans }}</a>
            <button type="submit" form="event_form" class="btn btn-success">{{ 'button.save'|trans }}</button>
        </div>
    </div>
</div>
{% endblock %}
