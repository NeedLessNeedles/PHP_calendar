{% extends 'base.html.twig' %}

{% block title %}{{ 'alert.delete_event'|trans({'%id%': category.id|default('')}) }}{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center align-items-center mt-2" style="max-width: 500px;">
        <div class="auth-card d-flex flex-column gap-2">
            <h3 class="h3 mb-1 font-weight-normal">{{ 'alert.delete_event'|trans({'%id%': category.id|default('')}) }}</h3>
            <div>
                {{ form_start(form) }}
                {{ form_widget(form) }}

                <div class="d-flex justify-content-center mt-2 gap-2">
                    <a href="{{ url('app_event_index') }}" class="btn btn-secondary">{{ 'button.cancel'|trans }}</a>
                    <input type="submit" value="{{ 'button.delete'|trans }}" class="btn btn-danger" />
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
