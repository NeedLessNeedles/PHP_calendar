{% extends 'base.html.twig' %}

{% block title %}{{ 'label.tags'|trans }}{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center align-items-center mt-3">
        <div class="auth-card d-flex flex-column gap-1" style="max-width: 900px;">
            <div class="container mt-3">
                <h2>{{ 'label.tags'|trans }}</h2>

                <table class="table">
                    <thead>
                    <tr>
                        <th>{{ knp_pagination_sortable(pagination, 'th.id'|trans, 'tag.id') }}</th>
                        <th>{{ knp_pagination_sortable(pagination, 'th.title'|trans, 'tag.title') }}</th>
                        <th>{{ 'th.actions'|trans }}</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for tag in pagination.items %}
                        <tr>
                            <td>{{ tag.id }}</td>
                            <td>{{ tag.title }}</td>
                            <td>
                                <a class="btn btn-primary btn-sm edit-category-btn" href="{{ path('app_tag_edit', {'id': tag.id}) }}">{{ 'button.edit'|trans }}</a>
                                <a class="btn btn-danger btn-sm" href="{{ path('app_tag_delete', {'id': tag.id}) }}">{{ 'button.delete'|trans }}</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-center navigation mt-1">
                {{ knp_pagination_render(pagination) }}
            </div>
            <div class="d-flex justify-content-center gap-2 mt-2 mb-2">
                <a class="btn btn-success" href="{{ path('app_tag_new') }}">{{ 'button.create_new'|trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
