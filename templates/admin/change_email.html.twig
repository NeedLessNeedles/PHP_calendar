{% extends 'base.html.twig' %}

{% block title %}{{ 'title.change_email'|trans }}{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center align-items-center mt-3">
        <div class="auth-card d-flex flex-column gap-1">
            <h1 class="h3 mb-2 font-weight-normal">{{ 'title.change_email'|trans }}</h1>
            <div>
                <label>{{ 'label.email'|trans }}:</label>
                <strong>{{ user.email }}</strong>
            </div>
            {% set roles = user.roles %}
            <div>
                <label>{{ 'label.role'|trans }}</label>
                {% if 'ROLE_ADMIN' in roles %}
                    <strong>{{ 'label.role_admin'|trans }}</strong>
                {% elseif 'ROLE_USER' in roles %}
                    <strong>{{ 'label.role_user'|trans }}</strong>
                {% else %}
                    <strong>{{ 'label.role_unknown'|trans }}</strong>
                {% endif %}
            </div>

            <div class="card card-body py-2">
                {{ form_start(form, {
                    'attr': {'novalidate': 'novalidate'}
                }) }}
                {{ form_widget(form) }}
                <div class="d-flex justify-content-center gap-2 mt-1">
                    <a href="{{ path('app_admin_users_edit', {'id': user.id}) }}" class="btn btn-secondary">{{ 'button.cancel'|trans }}</a>
                    <input type="submit" value="{{ 'button.save'|trans }}" class="btn btn-success" />
                </div>
                {{ form_end(form) }}
            </div>

        </div>
    </div>
{% endblock %}
