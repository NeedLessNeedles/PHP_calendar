{% extends 'base.html.twig' %}

{% block title %}{{ 'option.requests'|trans }}{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center align-items-center mt-3">
        <div class="auth-card d-flex flex-column gap-1" style="max-width: 800px;">
            <div class="container mt-3">
                <h2>{{ 'title.pending_events'|trans }}</h2>

                <table class="table">
                    <thead>
                    <tr>
                        <th>{{ 'th.id'|trans }}</th>
                        <th>{{ 'th.title'|trans }}</th>
                        <th>{{ knp_pagination_sortable(pagination, 'th.start_date'|trans, 'event.startDate') }}</th>
                        <th>{{ 'th.owner'|trans }}</th>
                        <th>{{ 'th.actions'|trans }}</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for event in pagination.items %}
                        <tr>
                            <td>{{ event.id }}</td>
                            <td>{{ event.title }}</td>
                            <td>{{ event.startDate|format_date('medium') }}</td>
                            <td>{{ event.owner ? event.owner.email : 'guest' }}</td>
                            <td class="d-flex gap-2">

                                <form method="post" action="{{ path('app_admin_requests_approve', {'id': event.id}) }}">
                                    <button class="btn btn-success btn-sm">{{ 'button.approve'|trans }}</button>
                                </form>

                                <form method="post" action="{{ path('app_admin_requests_reject', {'id': event.id}) }}">
                                    <button class="btn btn-danger btn-sm">{{ 'button.reject'|trans }}</button>
                                </form>

                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                <div class="d-flex justify-content-center navigation mt-1">
                    {{ knp_pagination_render(pagination) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
