{% extends 'base.html.twig' %}

{% block title %}{{ 'option.categories'|trans }}{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center align-items-center mt-3">
        <div class="auth-card d-flex flex-column gap-1" style="max-width: 900px;">
            <div class="container mt-3">
                <h2>{{ 'option.categories'|trans }}</h2>

                <table class="table">
                    <thead>
                    <tr>
                        <th>{{ 'th.id'|trans }}</th>
                        <th>{{ 'th.title'|trans }}</th>
                        <th>{{ knp_pagination_sortable(pagination, 'th.created_at'|trans, 'category.createdAt') }}</th>
                        <th>{{ knp_pagination_sortable(pagination, 'th.updated_at'|trans, 'category.updatedAt') }}</th>
                        <th>{{ 'th.actions'|trans }}</th>
                    </tr>
                    </thead>
                    {#                    "none", "short", "medium", "long", "full", "relative_short", "relative_medium", "relative_long", "relative_full"#}

                    <tbody>
                    {% for category in pagination.items %}
                        <tr>
                            <td>{{ category.id }}</td>
                            <td>{{ category.title }}</td>
                            <td>{{ category.createdAt ? category.createdAt|format_date('medium') : '' }}</td>
                            <td>{{ category.updatedAt|format_date('medium') }}</td>
                            <td>
                                <a class="btn btn-primary btn-sm edit-category-btn" href="{{ path('app_category_edit', {'id': category.id}) }}">{{ 'button.edit'|trans }}</a>
                                <a class="btn btn-danger btn-sm" href="{{ path('app_category_delete', {'id': category.id}) }}">{{ 'button.delete'|trans }}</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-center navigation mt-1">
                {{ knp_pagination_render(pagination) }}
            </div>
            <div class="d-flex justify-content-center gap-2 mt-2 mb-2">
                <a class="btn btn-success" href="{{ path('app_category_new') }}">{{ 'button.create_new'|trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
