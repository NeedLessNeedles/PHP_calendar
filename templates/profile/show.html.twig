{% extends 'base.html.twig' %}

{% block title %}{{ 'title.profile'|trans }}{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center align-items-center mt-3">
        <div class="auth-card d-flex flex-column gap-1">
            <h1 class="h3 mb-2 font-weight-normal">{{ 'title.user_info'|trans }}</h1>
            <div>
                <label>{{ 'label.email'|trans }}:</label>
                <strong>{{ app.user.email }}</strong>
            </div>
            {% set roles = app.user.roles %}
            <div>
                <label>{{ 'label.role'|trans }}</label>
                {% if 'ROLE_ADMIN' in roles %}
                    <strong>{{ 'label.role_admin'|trans }}</strong>
                {% elseif 'ROLE_USER' in roles %}
                    <strong>{{ 'label.role_user'|trans }}</strong>
                {% else %}
                    <strong>{{ 'label.role_unknown'|trans }}</strong>
                {% endif %}
            </div>

            <div class="d-flex justify-content-center gap-2 mt-2 mb-2">

                <a class="btn btn-outline-primary" href="{{ path('app_profile_change_email') }}">{{ 'button.change_email'|trans }}</a>
                <a class="btn btn-outline-primary" href="{{ path('app_profile_change_password') }}">{{ 'button.change_password'|trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
